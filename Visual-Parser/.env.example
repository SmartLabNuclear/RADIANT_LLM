# ============================================================
# visual-parser — Environment Variables
# Copy this file to .env and fill in your values.
# The .env file can sit next to visual-parser.py, in the current working directory,
# or in ~/.config/visual-parser/.env (legacy ~/.config/visual-rag/.env also works).
# ============================================================

# ---- HuggingFace Hub token (suppresses rate-limit warnings for Nougat) ----
# Free token: https://huggingface.co/settings/tokens  (read-only scope is enough)
HF_TOKEN=hf_...

# ---- Vision LLM API Keys (at least one required) --------
# GPT API Key
OPENAI_API_KEY=

# Alternative to OPENAI_API_KEY above -- only takes effect when OPENAI_API_KEY
# is absent/empty (direct OpenAI always wins if both are set). Requires the
# Portkey AI Provider slug below (found on your Portkey integration's detail
# page, e.g. "@myworkspace-openai-abc123" -> just the part after "@"). Lets
# --list-models and every vision-LLM call see whatever models your Portkey
# gateway exposes, including ones not on your direct OpenAI account.
# PORTKEY_API_KEY=
# PORTKEY_OPENAI_PROVIDER_SLUG=
# Forces Portkey even when OPENAI_API_KEY is set at the OS/system level
# (outside this file) -- commenting out the line above alone can't disable a
# system-level env var. Leave unset/false for normal precedence.
# VISUAL_PARSER_FORCE_PORTKEY=false

# GEMINI API KEY
GEMINI_API_KEY=

# ---- Pipeline defaults (all optional — overridden by CLI flags) ----

# Input directory to scan for PDFs
# VISUAL_PARSER_INPUT_DIR=/path/to/my_pdfs

# Output directory for JSONL files (defaults to input dir if not set)
# VISUAL_PARSER_OUTPUT_DIR=/path/to/output

# Text extraction engine: nougat | lightweight
# VISUAL_PARSER_TEXT_MODE=nougat

# Nougat model (HuggingFace model ID)
# VISUAL_PARSER_NOUGAT_MODEL=facebook/nougat-small

# Chunk settings
# VISUAL_PARSER_CHUNK_SIZE=500
# VISUAL_PARSER_CHUNK_OVERLAP=100

# Vision LLM provider: gpt | gemini
# VISUAL_PARSER_VISION_PROVIDER=gpt

# GPT vision model
# VISUAL_PARSER_GPT_VISION_MODEL=gpt-5.5

# Gemini vision model
# VISUAL_PARSER_GEMINI_VISION_MODEL=gemini-1.5-pro

# Image detail level sent to vision API: low | high | auto
# VISUAL_PARSER_VISION_DETAIL=low

# Number of front pages used for metadata extraction
# VISUAL_PARSER_METADATA_PAGES=2

# Thread-pool size
# VISUAL_PARSER_MAX_WORKERS=4

# Force full reparse on every run: true | false
# VISUAL_PARSER_REBUILD=false

# Log level written to 05_pipeline.log: DEBUG | INFO | WARNING | ERROR
# VISUAL_PARSER_LOG_LEVEL=ERROR
